{
  "profiles": {
    "http": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_SERVICE_NAME": "Game-Server(local)",
        "NODE_IP": "otel.rpgp.cc"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5085"
    },
    "https": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_SERVICE_NAME": "Game-Server(local)",
        "NODE_IP": "otel.rpgp.cc"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7131;http://localhost:5085"
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "publishAllPorts": true,
      "useSSL": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "OTEL_SERVICE_NAME": "Game-Server(local)",
        "NODE_IP": "otel.rpgp.cc"
      }
    }
  }
}
